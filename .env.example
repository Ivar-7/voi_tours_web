# Environment Variables — Voi Tours Frontend
#
# This app has no separate backend — Firebase (Auth, Firestore, Functions,
# Storage) IS the backend. See README.md for setup details.

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- App ---
VITE_APP_ENV=development

# Set to "true" (in a local .env.local, never committed) to point the dev
# server at `firebase emulators:start` instead of the real Firebase
# project — keeps local testing from writing into production data.
VITE_USE_FIREBASE_EMULATORS=false
